# ============================================================
# KOLEXA BACKEND — Variables de Entorno
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env real a git — solo este .env.example
# ============================================================

# --- Base de Datos ---
# URL de conexión a Supabase PostgreSQL.
# La encuentras en: Supabase → Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# --- JWT (Autenticación) ---
# Clave secreta para firmar los tokens JWT.
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cambia_esto_por_una_clave_segura_y_larga"

# Tiempo de expiración del access token (1 hora recomendado)
JWT_EXPIRES_IN="1h"

# Tiempo de expiración del refresh token (7 días recomendado)
JWT_REFRESH_EXPIRES_IN="7d"

# --- Servidor ---
# Puerto en el que escucha el servidor (8082 para compatibilidad con el original)
PORT=3000

# --- Firebase (Push Notifications) ---
# JSON completo de credenciales de Firebase Admin SDK.
# Lo obtienes en: Firebase Console → Project Settings → Service Accounts → Generate new private key
# IMPORTANTE: Pégalo en UNA sola línea o usa una ruta al archivo JSON
FIREBASE_PROJECT_ID="kolexa"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@kolexa.iam.gserviceaccount.com"

# --- Gemini (lectura de horarios desde foto) ---
# API key de Google AI Studio: https://aistudio.google.com/apikey
# Solo se usa en POST /admin/schedule-import/analyze. Si se deja vacía, esa
# funcionalidad queda deshabilitada (responde 503) pero el resto de la app
# arranca y funciona con normalidad.
GEMINI_API_KEY=""
# Opcional. Por defecto usa un modelo Flash (incluido en el free tier).
GEMINI_MODEL="gemini-flash-latest"

# --- Supabase Storage ---
# Para subir archivos (fotos, PDFs de tareas, adjuntos)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_KEY="eyJ..."
# Nombre del bucket de Storage donde se guardan las fotos (crear en Supabase → Storage)
SUPABASE_STORAGE_BUCKET="attendance"
