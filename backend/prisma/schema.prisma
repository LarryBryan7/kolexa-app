// ============================================================
// schema.prisma — Schema de la base de datos (versión corregida)
// ============================================================
// Los nombres de campos en Prisma siguen las convenciones de los
// servicios NestJS. Las columnas en PostgreSQL usan snake_case
// gracias a los @map("...") y @@map("...").
//
// Comandos:
//   npx prisma generate       → regenera el cliente TypeScript
//   npx prisma migrate dev    → aplica cambios a la BD
//   npx prisma studio         → interfaz visual de la BD
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SECCIÓN 1: DATOS GEOGRÁFICOS DE REFERENCIA
// ============================================================

model Country {
  id      Int      @id @default(autoincrement())
  name    String   @db.VarChar(100)
  code    String   @unique @db.Char(3)
  regions Region[]

  @@map("countries")
}

model Region {
  id        Int        @id @default(autoincrement())
  countryId Int        @map("country_id")
  name      String     @db.VarChar(100)
  country   Country    @relation(fields: [countryId], references: [id])
  provinces Province[]

  @@map("regions")
}

model Province {
  id        Int        @id @default(autoincrement())
  regionId  Int        @map("region_id")
  name      String     @db.VarChar(100)
  region    Region     @relation(fields: [regionId], references: [id])
  districts District[]

  @@map("provinces")
}

model District {
  id         Int      @id @default(autoincrement())
  provinceId Int      @map("province_id")
  name       String   @db.VarChar(100)
  province   Province @relation(fields: [provinceId], references: [id])
  schools    School[]
  users      User[]

  @@map("districts")
}

// ============================================================
// SECCIÓN 2: ESTRUCTURA ORGANIZACIONAL
// ============================================================

model School {
  id         BigInt   @id @default(autoincrement())
  name       String   @db.VarChar(255)
  tradeName  String?  @map("trade_name") @db.VarChar(255)
  ruc        String?  @db.VarChar(20)
  phone      String?  @db.VarChar(20)
  email      String?  @db.VarChar(128)
  logoUrl    String?  @map("logo_url")
  address    String?
  districtId Int?     @map("district_id")
  isActive   Boolean  @default(true) @map("is_active")
  metadata   Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  district          District?              @relation(fields: [districtId], references: [id])
  locations         SchoolLocation[]
  courses           Course[]
  students          Student[]
  subscriptions     SchoolSubscription[]
  moduleOverrides   SchoolModuleOverride[]
  announcements     Announcement[]
  appointmentSlots  AppointmentSlot[]
  suggestions       Suggestion[]
  gradePeriods      GradePeriod[]
  paymentConcepts   PaymentConcept[]
  discountCampaigns DiscountCampaign[]
  notifications     Notification[]
  userRoles         UserRole[]
  invitations       SchoolInvitation[]
  parents           Parent[]
  gcCourseLinks     GcCourseLink[]
  threads           Thread[]

  @@map("schools")
}

model SchoolLocation {
  id         BigInt   @id @default(autoincrement())
  schoolId   BigInt   @map("school_id")
  name       String   @db.VarChar(255)
  address    String?
  phone      String?  @db.VarChar(20)
  districtId Int?     @map("district_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  school     School      @relation(fields: [schoolId], references: [id])
  classrooms Classroom[]

  @@map("school_locations")
}

model Classroom {
  id               BigInt   @id @default(autoincrement())
  schoolLocationId BigInt   @map("school_location_id")
  name             String   @db.VarChar(100)
  grade            String?  @db.VarChar(50)
  section          String?  @db.VarChar(10)
  academicYear     Int      @map("academic_year") @db.SmallInt
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  schoolLocation   SchoolLocation      @relation(fields: [schoolLocationId], references: [id])
  classroomCourses ClassroomCourse[]
  enrollments      StudentEnrollment[]
  userClassrooms   UserClassroom[]
  attendances      Attendance[]
  homeworks        Homework[]
  scheduleBlocks   ScheduleBlock[]

  @@map("classrooms")
}

// ============================================================
// SECCIÓN 3: USUARIOS Y AUTENTICACIÓN
// ============================================================

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String?

  userRoles      UserRole[]
  userClassrooms UserClassroom[]
  invitations    SchoolInvitation[]

  @@map("roles")
}

model User {
  id                  BigInt    @id @default(autoincrement())
  email               String    @unique @db.VarChar(128)
  // googleSub: identificador único de la cuenta Google (sub del ID Token).
  //   - nullable: los usuarios con email/password no tienen Google.
  //   - unique: una cuenta Google = un User.
  //   - asignado EXCLUSIVAMENTE por el backend tras validar el ID Token.
  //   - NUNCA se acepta como dato confiado desde el cliente.
  googleSub           String?   @unique @map("google_sub") @db.VarChar(64)
  passwordHash        String    @map("password_hash")
  // firstName / lastName en lugar de names / lastNames
  firstName           String    @map("first_name") @db.VarChar(255)
  lastName            String?   @map("last_name") @db.VarChar(255)
  dni                 String?   @db.VarChar(20)
  phone               String?   @db.VarChar(20)
  phone2              String?   @db.VarChar(20)
  sex                 String?   @db.Char(1)
  birthday            DateTime? @db.Date
  // avatar en lugar de avatarUrl
  avatar              String?   @map("avatar_url")
  address             String?
  districtId          Int?      @map("district_id")
  needsPasswordChange Boolean   @default(false) @map("needs_password_change")
  isActive            Boolean   @default(true) @map("is_active")
  metadata            Json      @default("{}") @db.JsonB
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz()
  // Para el punto verde/gris de "en línea" en chats: se actualiza en cada
  // request autenticado (con throttle, ver JwtStrategy) — no requiere
  // WebSocket ni tabla de sesiones nueva. "En línea" = actualizado hace
  // menos de N minutos (ver ONLINE_THRESHOLD_MINUTES en threads.service.ts).
  lastActiveAt        DateTime? @map("last_active_at") @db.Timestamptz()

  district                    District?             @relation(fields: [districtId], references: [id])
  userRoles                   UserRole[]
  userTokens                  UserToken[]
  userStudents                UserStudent[]
  userClassrooms              UserClassroom[]
  threadParticipations        ThreadParticipant[]
  sentThreadMessages          ThreadMessage[]
  attendancesTaken            Attendance[]
  homeworks                   Homework[]            @relation("HomeworkTeacher")
  anecdotes                   Anecdote[]
  announcements               Announcement[]
  appointmentSlots            AppointmentSlot[]
  appointments                Appointment[]
  classroomCourses            ClassroomCourse[]
  pickupEventsRecorded        PickupEvent[]
  suggestionResponses         SuggestionResponse[]
  suggestions                 Suggestion[]
  announcementReads           AnnouncementRead[]
  paymentsReceived            Payment[]             @relation("PaymentReceiver")
  attachmentsUploaded         Attachment[]
  authorizedPickupsRegistered AuthorizedPickup[]
  couponRedemptions           CouponRedemption[]
  discountCampaigns           DiscountCampaign[]
  paymentConcepts             PaymentConcept[]
  gradesGiven                 Grade[]               @relation("GradeTeacher")
  teacherGoogleToken          TeacherGoogleToken?
  gcTeacherCourses            GcTeacherCourse[]
  scheduleBlocksOwned         ScheduleBlock[]       @relation("ScheduleBlockOwner")
  gcAttendanceSessions        GcAttendanceSession[] @relation("GcAttendanceTeacher")
  pushTokens                  PushToken[]
  invitationsSent             SchoolInvitation[]    @relation("InvitationSender")
  // parentProfiles: un User (cuenta) puede ser padre/apoderado en uno o varios
  // colegios, por lo que puede tener múltiples perfiles institucionales Parent.
  parentProfiles              Parent[]

  @@map("users")
}

model UserToken {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  tokenType  String    @map("token_type") @db.VarChar(20)
  token      String
  deviceInfo Json?     @map("device_info") @db.JsonB
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@map("user_tokens")
}

model UserRole {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  roleId    Int      @map("role_id")
  schoolId  BigInt?  @map("school_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user   User    @relation(fields: [userId], references: [id])
  role   Role    @relation(fields: [roleId], references: [id])
  school School? @relation(fields: [schoolId], references: [id])

  @@unique([userId, roleId, schoolId])
  @@map("user_roles")
}

// ============================================================
// SECCIÓN 4: ALUMNOS
// ============================================================

model Student {
  id        BigInt    @id @default(autoincrement())
  schoolId  BigInt    @map("school_id")
  firstName String    @map("first_name") @db.VarChar(255)
  lastName  String?   @map("last_name") @db.VarChar(255)
  // code: código interno del alumno (matrícula, DNI interno)
  code      String?   @db.VarChar(20)
  dni       String?   @db.VarChar(20)
  birthday  DateTime? @db.Date
  sex       String?   @db.Char(1)
  avatar    String?   @map("avatar_url")
  isActive  Boolean   @default(true) @map("is_active")
  metadata  Json      @default("{}") @db.JsonB
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  school             School              @relation(fields: [schoolId], references: [id])
  enrollments        StudentEnrollment[]
  // parents: relación padre/madre/tutor → alumno
  parents            UserStudent[]
  attendanceRecords  AttendanceRecord[]
  submissions        StudentHomework[]
  anecdotes          Anecdote[]
  grades             Grade[]
  paymentObligations PaymentObligation[]
  authorizedPickups  AuthorizedPickup[]
  pickupEvents       PickupEvent[]
  appointments       Appointment[]
  threads            Thread[]
  googleToken        GoogleToken?
  gcCourses          GcCourse[]
  gcCourseStudents   GcCourseStudent[]   @relation("GcCourseStudentLink")
  parentLinks        ParentStudent[]

  @@map("students")
}

model StudentEnrollment {
  id           BigInt    @id @default(autoincrement())
  studentId    BigInt    @map("student_id")
  classroomId  BigInt    @map("classroom_id")
  academicYear Int       @map("academic_year") @db.SmallInt
  enrolledAt   DateTime  @default(now()) @map("enrolled_at") @db.Date
  withdrawnAt  DateTime? @map("withdrawn_at") @db.Date
  // isActive: si la matrícula está vigente
  isActive     Boolean   @default(true) @map("is_active")

  student   Student   @relation(fields: [studentId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@unique([studentId, classroomId, academicYear])
  @@map("student_enrollments")
}

model UserStudent {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  studentId    BigInt   @map("student_id")
  relationship String?  @db.VarChar(50)
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user    User    @relation(fields: [userId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([userId, studentId])
  @@map("user_students")
}

model UserClassroom {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  classroomId BigInt   @map("classroom_id")
  roleId      Int      @map("role_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user      User      @relation(fields: [userId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])

  @@unique([userId, classroomId])
  @@map("user_classrooms")
}

// ============================================================
// SECCIÓN 5: ESTRUCTURA ACADÉMICA
// ============================================================

model Course {
  id        BigInt   @id @default(autoincrement())
  schoolId  BigInt   @map("school_id")
  name      String   @db.VarChar(100)
  code      String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  school           School            @relation(fields: [schoolId], references: [id])
  classroomCourses ClassroomCourse[]
  grades           Grade[]
  homeworks        Homework[]
  attendances      Attendance[]

  @@map("courses")
}

// ClassroomCourse: qué cursos se dictan en cada salón y quién los dicta
model ClassroomCourse {
  id          BigInt  @id @default(autoincrement())
  classroomId BigInt  @map("classroom_id")
  courseId    BigInt  @map("course_id")
  teacherId   BigInt? @map("teacher_id")

  classroom      Classroom       @relation(fields: [classroomId], references: [id])
  course         Course          @relation(fields: [courseId], references: [id])
  teacher        User?           @relation(fields: [teacherId], references: [id])
  scheduleBlocks ScheduleBlock[]
  gcLinks        GcCourseLink[]

  @@unique([classroomId, courseId])
  @@map("classroom_courses")
}

// Puente entre un curso de Google Classroom y el curso institucional de KOLEXA.
//
// Ancla en `googleCourseId` (el id que da Google) y NO en gc_teacher_courses ni
// gc_courses: esas dos son cachés del mismo curso vistos desde el consentimiento
// del docente y del alumno, se borran y se re-sincronizan. El vínculo tiene que
// sobrevivir a eso, y vale para ambos lados a la vez.
//
// Lo crea el administrador al confirmar la importación desde Classroom — la IA
// y la sincronización proponen, el administrador confirma.
model GcCourseLink {
  id                BigInt   @id @default(autoincrement())
  schoolId          BigInt   @map("school_id")
  googleCourseId    String   @map("google_course_id") @db.VarChar(64)
  classroomCourseId BigInt   @map("classroom_course_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  school          School          @relation(fields: [schoolId], references: [id])
  classroomCourse ClassroomCourse @relation(fields: [classroomCourseId], references: [id], onDelete: Cascade)

  // Un curso de Google apunta a un solo curso institucional dentro del colegio.
  @@unique([schoolId, googleCourseId])
  @@index([classroomCourseId])
  @@map("gc_course_links")
}

// ============================================================
// MÓDULO 0: HORARIO
// ============================================================

model ScheduleBlock {
  id                BigInt   @id @default(autoincrement())
  classroomId       BigInt?  @map("classroom_id")
  classroomCourseId BigInt?  @map("classroom_course_id")
  gcTeacherCourseId BigInt?  @map("gc_teacher_course_id")
  // docente dueño del bloque (para bloques basados en GC)
  ownerId           BigInt?  @map("owner_id")
  // 'class' | 'recess' | 'break' | 'lunch' | 'activity'
  // 'activity' cubre bloques no académicos con nombre propio (TUTORÍA,
  // SALIDA, FORMACIÓN…): no tienen curso asociado, su nombre va en `label`.
  type              String   @default("class") @db.VarChar(20)
  // Etiqueta libre para bloques sin curso (type != 'class'). Para 'recess'/
  // 'break'/'lunch' es opcional (ya tienen nombre por convención); para
  // 'activity' es la única fuente del nombre visible.
  label             String?  @db.VarChar(100)
  // dayOfWeek: 1=lunes … 5=viernes
  dayOfWeek         Int      @map("day_of_week") @db.SmallInt
  startTime         DateTime @map("start_time") @db.Time()
  endTime           DateTime @map("end_time") @db.Time()
  room              String?  @db.VarChar(100)

  classroom       Classroom?       @relation(fields: [classroomId], references: [id])
  classroomCourse ClassroomCourse? @relation(fields: [classroomCourseId], references: [id])
  gcTeacherCourse GcTeacherCourse? @relation(fields: [gcTeacherCourseId], references: [id])
  owner           User?            @relation("ScheduleBlockOwner", fields: [ownerId], references: [id])

  @@map("schedule_blocks")
}

// ============================================================
// SECCIÓN 6: PLANES Y PERMISOS (Multi-tenant)
// ============================================================

model SubscriptionPlan {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  description  String?
  priceMonthly Decimal? @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal? @map("price_yearly") @db.Decimal(10, 2)
  maxStudents  Int?     @map("max_students")
  isActive     Boolean  @default(true) @map("is_active")
  metadata     Json     @default("{}") @db.JsonB

  planModules   PlanModule[]
  subscriptions SchoolSubscription[]

  @@map("subscription_plans")
}

model PlanModule {
  id        Int    @id @default(autoincrement())
  planId    Int    @map("plan_id")
  moduleKey String @map("module_key") @db.VarChar(50)

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@unique([planId, moduleKey])
  @@map("plan_modules")
}

model SchoolSubscription {
  id        BigInt    @id @default(autoincrement())
  schoolId  BigInt    @map("school_id")
  planId    Int       @map("plan_id")
  startsAt  DateTime  @map("starts_at") @db.Date
  endsAt    DateTime? @map("ends_at") @db.Date
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  school School           @relation(fields: [schoolId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("school_subscriptions")
}

model SchoolModuleOverride {
  id        BigInt  @id @default(autoincrement())
  schoolId  BigInt  @map("school_id")
  moduleKey String  @map("module_key") @db.VarChar(50)
  isEnabled Boolean @default(true) @map("is_enabled")

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, moduleKey])
  @@map("school_module_overrides")
}

// ============================================================
// ADJUNTOS
// ============================================================

model Attachment {
  id              BigInt   @id @default(autoincrement())
  uploaderId      BigInt?  @map("uploader_id")
  url             String
  fileName        String?  @map("file_name") @db.VarChar(500)
  mimeType        String?  @map("mime_type") @db.VarChar(100)
  sizeBytes       BigInt?  @map("size_bytes")
  storageProvider String   @default("supabase") @map("storage_provider") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  uploader                User?                    @relation(fields: [uploaderId], references: [id])
  homeworkAttachments     HomeworkAttachment[]
  anecdoteAttachments     AnecdoteAttachment[]
  announcementAttachments AnnouncementAttachment[]

  @@map("attachments")
}

// ============================================================
// MÓDULO 1: ASISTENCIA
// ============================================================

model Attendance {
  id          BigInt   @id @default(autoincrement())
  classroomId BigInt   @map("classroom_id")
  // courseId: qué curso se está pasando asistencia
  courseId    BigInt?  @map("course_id")
  teacherId   BigInt   @map("teacher_id")
  date        DateTime @db.Date
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  classroom Classroom          @relation(fields: [classroomId], references: [id])
  course    Course?            @relation(fields: [courseId], references: [id])
  teacher   User               @relation(fields: [teacherId], references: [id])
  records   AttendanceRecord[]

  @@unique([classroomId, date])
  @@map("attendances")
}

model AttendanceRecord {
  id            BigInt  @id @default(autoincrement())
  attendanceId  BigInt  @map("attendance_id")
  studentId     BigInt  @map("student_id")
  // 'present', 'absent', 'late', 'justified'
  status        String  @default("present") @db.VarChar(20)
  // lateMinutes: minutos de tardanza (si status = 'late')
  lateMinutes   Int?    @map("late_minutes")
  justification String?
  observation   String?

  attendance Attendance @relation(fields: [attendanceId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@unique([attendanceId, studentId])
  @@map("attendance_records")
}

// ============================================================
// MÓDULO 2: TAREAS
// ============================================================

model Homework {
  id            BigInt    @id @default(autoincrement())
  classroomId   BigInt    @map("classroom_id")
  courseId      BigInt    @map("course_id")
  teacherId     BigInt    @map("teacher_id")
  title         String    @db.VarChar(500)
  description   String?
  dueDate       DateTime? @map("due_date") @db.Date
  // notifyParents: si se envía notificación push a los padres al crear
  notifyParents Boolean   @default(true) @map("notify_parents")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz()

  classroom   Classroom            @relation(fields: [classroomId], references: [id])
  course      Course               @relation(fields: [courseId], references: [id])
  teacher     User                 @relation("HomeworkTeacher", fields: [teacherId], references: [id])
  attachments HomeworkAttachment[]
  submissions StudentHomework[]

  @@map("homeworks")
}

model HomeworkAttachment {
  homeworkId   BigInt @map("homework_id")
  attachmentId BigInt @map("attachment_id")

  homework   Homework   @relation(fields: [homeworkId], references: [id])
  attachment Attachment @relation(fields: [attachmentId], references: [id])

  @@id([homeworkId, attachmentId])
  @@map("homework_attachments")
}

// StudentHomework: estado de la entrega por cada alumno
model StudentHomework {
  id          BigInt    @id @default(autoincrement())
  homeworkId  BigInt    @map("homework_id")
  studentId   BigInt    @map("student_id")
  // 'pending', 'submitted', 'reviewed'
  status      String    @default("pending") @db.VarChar(20)
  grade       Decimal?  @db.Decimal(5, 2)
  teacherNote String?   @map("teacher_note")
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz()
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz()

  homework Homework @relation(fields: [homeworkId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])

  @@unique([homeworkId, studentId])
  @@map("student_homeworks")
}

// ============================================================
// MÓDULO 3: ANÉCDOTAS
// ============================================================

model Anecdote {
  id          BigInt    @id @default(autoincrement())
  authorId    BigInt    @map("creator_id")
  studentId   BigInt    @map("student_id")
  classroomId BigInt?   @map("classroom_id")
  title       String    @db.VarChar(500)
  description String
  // category: 'general', 'behavior', 'academic', 'social', 'health'
  category    String    @default("general") @db.VarChar(50)
  // isPrivate: si es privada, el padre NO la ve
  isPrivate   Boolean   @default(false) @map("is_private")
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  author      User                 @relation(fields: [authorId], references: [id])
  student     Student              @relation(fields: [studentId], references: [id])
  attachments AnecdoteAttachment[]

  @@map("anecdotes")
}

model AnecdoteAttachment {
  anecdoteId   BigInt @map("anecdote_id")
  attachmentId BigInt @map("attachment_id")

  anecdote   Anecdote   @relation(fields: [anecdoteId], references: [id])
  attachment Attachment @relation(fields: [attachmentId], references: [id])

  @@id([anecdoteId, attachmentId])
  @@map("anecdote_attachments")
}

// ============================================================
// MÓDULO 4: COMUNICADOS
// ============================================================

model Announcement {
  id          BigInt    @id @default(autoincrement())
  authorId    BigInt    @map("creator_id")
  schoolId    BigInt    @map("school_id")
  title       String    @db.VarChar(500)
  // content en lugar de body
  content     String    @map("body")
  category    String    @default("general") @db.VarChar(30)
  scopeType   String    @map("scope_type") @db.VarChar(20)
  scopeId     BigInt?   @map("scope_id")
  isPinned    Boolean   @default(false) @map("is_pinned")
  // publishedAt en lugar de publishAt
  publishedAt DateTime? @map("publish_at") @db.Timestamptz()
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  author      User                     @relation(fields: [authorId], references: [id])
  school      School                   @relation(fields: [schoolId], references: [id])
  attachments AnnouncementAttachment[]
  // readRecords en lugar de reads
  readRecords AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementAttachment {
  announcementId BigInt @map("announcement_id")
  attachmentId   BigInt @map("attachment_id")

  announcement Announcement @relation(fields: [announcementId], references: [id])
  attachment   Attachment   @relation(fields: [attachmentId], references: [id])

  @@id([announcementId, attachmentId])
  @@map("announcement_attachments")
}

model AnnouncementRead {
  announcementId BigInt    @map("announcement_id")
  userId         BigInt    @map("user_id")
  // isRead: false = no leído, true = leído
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at") @db.Timestamptz()

  announcement Announcement @relation(fields: [announcementId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@id([announcementId, userId])
  @@map("announcement_reads")
}

// ============================================================
// MÓDULO 5: CITAS
// ============================================================

model AppointmentSlot {
  id          BigInt   @id @default(autoincrement())
  schoolId    BigInt   @map("school_id")
  teacherId   BigInt   @map("teacher_id")
  startTime   DateTime @map("start_time") @db.Timestamptz()
  endTime     DateTime @map("end_time") @db.Timestamptz()
  maxBookings Int      @default(1) @map("max_bookings")
  location    String?  @db.VarChar(200)
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  school       School        @relation(fields: [schoolId], references: [id])
  teacher      User          @relation(fields: [teacherId], references: [id])
  appointments Appointment[]

  @@map("appointment_slots")
}

model Appointment {
  id           BigInt    @id @default(autoincrement())
  slotId       BigInt    @map("slot_id")
  // parentId en lugar de requesterId
  parentId     BigInt    @map("requester_id")
  studentId    BigInt?   @map("student_id")
  reason       String?
  // 'scheduled', 'completed', 'cancelled', 'no_show'
  status       String    @default("scheduled") @db.VarChar(20)
  teacherNotes String?   @map("teacher_notes")
  completedAt  DateTime? @map("completed_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  slot    AppointmentSlot @relation(fields: [slotId], references: [id])
  parent  User            @relation(fields: [parentId], references: [id])
  student Student?        @relation(fields: [studentId], references: [id])

  @@map("appointments")
}

// ============================================================
// MÓDULO 6: MENSAJERÍA (hilos)
// ============================================================
// Reemplaza dos sistemas previos (Message/MessageRecipient tipo correo, y
// Conversation/ChatMessage tipo chat genérico) que coexistían sin conocerse
// y sin validar el colegio del destinatario — ver auditoría de mensajería
// del 30-08-2026. Un solo modelo, con el contexto escolar dentro.
//
// schoolId es obligatorio (no nullable): toda consulta se filtra por él desde
// el JWT, nunca desde el cliente. Es lo que faltaba en el modelo anterior.

model Thread {
  id            BigInt    @id @default(autoincrement())
  schoolId      BigInt    @map("school_id")
  // 'direct' (padre↔docente), 'alert' (aviso puntual, ej. ausencia).
  // Los comunicados masivos NO viven acá — siguen en Announcement, que ya
  // tiene su propio feed y confirmación de lectura por usuario.
  kind          String    @default("direct") @db.VarChar(20)
  subject       String?   @db.VarChar(255)
  // De qué alumno se habla. Es la llave que separa conversaciones del mismo
  // par de personas sobre hijos distintos, y lo que un padre con varios hijos
  // necesita ver de un vistazo en la bandeja.
  studentId     BigInt?   @map("student_id")
  priority      String    @default("normal") @db.VarChar(10) // 'normal' | 'urgent'
  // Se actualiza en cada mensaje nuevo. Ordena la bandeja sin tener que unir
  // contra la última fila de thread_messages en cada consulta.
  lastMessageAt DateTime  @default(now()) @map("last_message_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  closedAt      DateTime? @map("closed_at") @db.Timestamptz()

  school       School              @relation(fields: [schoolId], references: [id])
  student      Student?            @relation(fields: [studentId], references: [id])
  participants ThreadParticipant[]
  messages     ThreadMessage[]

  @@index([schoolId, lastMessageAt])
  @@index([studentId])
  @@map("threads")
}

model ThreadParticipant {
  threadId   BigInt    @map("thread_id")
  userId     BigInt    @map("user_id")
  // Un solo timestamp resuelve el no-leído: sin leer si
  // thread.lastMessageAt > lastReadAt (o lastReadAt es null). Evita una fila
  // de estado por mensaje — el problema de rendimiento del modelo anterior.
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz()
  mutedAt    DateTime? @map("muted_at") @db.Timestamptz()
  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz()

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@id([threadId, userId])
  @@index([userId, lastReadAt])
  @@map("thread_participants")
}

model ThreadMessage {
  id        BigInt    @id @default(autoincrement())
  threadId  BigInt    @map("thread_id")
  senderId  BigInt    @map("sender_id")
  body      String
  sentAt    DateTime  @default(now()) @map("sent_at") @db.Timestamptz()
  editedAt  DateTime? @map("edited_at") @db.Timestamptz()
  // Borrado lógico: un colegio puede necesitar mostrar qué se dijo. Nunca
  // DELETE físico en mensajería escolar.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id])

  @@index([threadId, sentAt])
  @@map("thread_messages")
}

// ============================================================
// MÓDULO 7: RECOJO DEL ALUMNO
// ============================================================

model AuthorizedPickup {
  id           BigInt   @id @default(autoincrement())
  studentId    BigInt   @map("student_id")
  // registeredBy: ID del padre que registró esta autorización
  registeredBy BigInt   @map("registered_by")
  // fullName en lugar de names + lastNames separados
  fullName     String   @map("names") @db.VarChar(255)
  // documentId en lugar de dni
  documentId   String?  @map("dni") @db.VarChar(20)
  phone        String?  @db.VarChar(20)
  relationship String?  @db.VarChar(50)
  photoUrl     String?  @map("photo_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  student            Student       @relation(fields: [studentId], references: [id])
  registeredByParent User          @relation(fields: [registeredBy], references: [id])
  pickupEvents       PickupEvent[]

  @@map("authorized_pickups")
}

model PickupEvent {
  id                 BigInt   @id @default(autoincrement())
  studentId          BigInt   @map("student_id")
  authorizedPickupId BigInt?  @map("authorized_pickup_id")
  // recordedBy: ID del portero/secretaria que registró el evento
  recordedBy         BigInt   @map("registered_by_id")
  // pickedUpByName: nombre de quien recogió al alumno
  pickedUpByName     String   @map("picked_up_by_name") @db.VarChar(255)
  // pickedUpAt en lugar de pickupTime
  pickedUpAt         DateTime @default(now()) @map("pickup_time") @db.Timestamptz()
  notes              String?
  photoUrl           String?  @map("photo_url")

  student          Student           @relation(fields: [studentId], references: [id])
  authorizedPickup AuthorizedPickup? @relation(fields: [authorizedPickupId], references: [id])
  recorder         User              @relation(fields: [recordedBy], references: [id])

  @@map("pickup_events")
}

// ============================================================
// MÓDULO 8: NOTAS DEL ALUMNO
// ============================================================

// GradePeriod: bimestres, trimestres, etc.
model GradePeriod {
  id           Int      @id @default(autoincrement())
  schoolId     BigInt   @map("school_id")
  academicYear Int      @map("academic_year") @db.SmallInt
  name         String   @db.VarChar(50)
  // startDate/endDate en lugar de startsAt/endsAt
  startDate    DateTime @map("starts_at") @db.Date
  endDate      DateTime @map("ends_at") @db.Date

  school School  @relation(fields: [schoolId], references: [id])
  grades Grade[]

  @@map("grade_periods")
}

model Grade {
  id           BigInt    @id @default(autoincrement())
  studentId    BigInt    @map("student_id")
  // courseId directo en lugar de classroomCourseId
  courseId     BigInt    @map("course_id")
  periodId     Int       @map("period_id")
  // grade en lugar de score
  grade        Decimal?  @db.Decimal(5, 2)
  // gradeType: 'numeric', 'letter', 'descriptive'
  gradeType    String?   @map("grade_type") @db.VarChar(20)
  // letterGrade: 'A', 'B', 'AD', 'C', etc.
  letterGrade  String?   @map("letter_grade") @db.VarChar(5)
  observations String?
  // gradedBy: el profesor que puso la nota
  gradedBy     BigInt?   @map("graded_by")
  gradedAt     DateTime? @map("graded_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  student      Student     @relation(fields: [studentId], references: [id])
  course       Course      @relation(fields: [courseId], references: [id])
  period       GradePeriod @relation(fields: [periodId], references: [id])
  gradedByUser User?       @relation("GradeTeacher", fields: [gradedBy], references: [id])

  @@unique([studentId, courseId, periodId])
  @@map("grades")
}

// ============================================================
// MÓDULO 9: CONTROL DE PAGOS
// ============================================================

model PaymentConcept {
  id          Int       @id @default(autoincrement())
  schoolId    BigInt    @map("school_id")
  name        String    @db.VarChar(255)
  description String?
  amount      Decimal   @db.Decimal(10, 2)
  // currency: 'PEN', 'USD', etc.
  currency    String    @default("PEN") @map("currency") @db.VarChar(10)
  dueDate     DateTime? @map("due_date") @db.Date
  isRecurring Boolean   @default(false) @map("is_recurring")
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   BigInt?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  school        School              @relation(fields: [schoolId], references: [id])
  createdByUser User?               @relation(fields: [createdBy], references: [id])
  obligations   PaymentObligation[]

  @@map("payment_concepts")
}

// PaymentObligation (singular) = lo que cada alumno debe pagar
model PaymentObligation {
  id         BigInt    @id @default(autoincrement())
  studentId  BigInt    @map("student_id")
  conceptId  Int       @map("concept_id")
  amount     Decimal   @db.Decimal(10, 2)
  currency   String    @default("PEN") @db.VarChar(10)
  dueDate    DateTime? @map("due_date") @db.Date
  // 'pending', 'partial', 'paid', 'overdue', 'waived'
  status     String    @default("pending") @db.VarChar(20)
  assignedBy BigInt?   @map("assigned_by")
  paidAt     DateTime? @map("paid_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  student  Student        @relation(fields: [studentId], references: [id])
  concept  PaymentConcept @relation(fields: [conceptId], references: [id])
  payments Payment[]

  @@unique([studentId, conceptId, dueDate])
  @@map("payment_obligations")
}

model Payment {
  id            BigInt   @id @default(autoincrement())
  obligationId  BigInt   @map("obligation_id")
  // amountPaid en lugar de amount
  amountPaid    Decimal  @map("amount") @db.Decimal(10, 2)
  paidAt        DateTime @default(now()) @map("paid_at") @db.Timestamptz()
  paymentMethod String?  @map("payment_method") @db.VarChar(30)
  reference     String?  @db.VarChar(255)
  // receivedBy en lugar de registeredById
  receivedBy    BigInt?  @map("registered_by_id")
  receiptUrl    String?  @map("receipt_url")
  notes         String?

  obligation     PaymentObligation @relation(fields: [obligationId], references: [id])
  receivedByUser User?             @relation("PaymentReceiver", fields: [receivedBy], references: [id])

  @@map("payments")
}

// ============================================================
// MÓDULO 11: BUZÓN DE SUGERENCIAS
// ============================================================

model Suggestion {
  id            BigInt    @id @default(autoincrement())
  schoolId      BigInt    @map("school_id")
  // submittedById: null si es anónima
  submittedById BigInt?   @map("submitter_id")
  category      String?   @db.VarChar(50)
  title         String?   @db.VarChar(500)
  // description en lugar de body
  description   String    @map("body")
  isAnonymous   Boolean   @default(false) @map("is_anonymous")
  // 'pending', 'in_review', 'resolved', 'closed'
  status        String    @default("pending") @db.VarChar(20)
  respondedAt   DateTime? @map("responded_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  school      School               @relation(fields: [schoolId], references: [id])
  submittedBy User?                @relation(fields: [submittedById], references: [id])
  responses   SuggestionResponse[]

  @@map("suggestions")
}

model SuggestionResponse {
  id            BigInt   @id @default(autoincrement())
  suggestionId  BigInt   @map("suggestion_id")
  respondedById BigInt   @map("responder_id")
  // response en lugar de body
  response      String   @map("body")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  suggestion  Suggestion @relation(fields: [suggestionId], references: [id])
  respondedBy User       @relation(fields: [respondedById], references: [id])

  @@map("suggestion_responses")
}

// ============================================================
// MÓDULO 12: CUPONERA DE DESCUENTO
// ============================================================

model DiscountCampaign {
  id             BigInt   @id @default(autoincrement())
  schoolId       BigInt   @map("school_id")
  name           String   @db.VarChar(255)
  description    String?
  discountType   String   @map("discount_type") @db.VarChar(20)
  discountValue  Decimal  @map("discount_value") @db.Decimal(10, 2)
  partnerName    String?  @map("partner_name") @db.VarChar(255)
  partnerLogo    String?  @map("partner_logo")
  // validFrom / validUntil en lugar de startsAt / expiresAt
  validFrom      DateTime @map("starts_at") @db.Timestamptz()
  validUntil     DateTime @map("expires_at") @db.Timestamptz()
  // maxRedemptions en lugar de maxUses
  maxRedemptions Int?     @map("max_uses")
  // maxPerUser: cuántas veces puede canjear UN usuario
  maxPerUser     Int?     @map("max_per_user")
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      BigInt?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  school        School             @relation(fields: [schoolId], references: [id])
  createdByUser User?              @relation(fields: [createdBy], references: [id])
  coupons       DiscountCoupon[]
  redemptions   CouponRedemption[]

  @@map("discount_campaigns")
}

model DiscountCoupon {
  id         BigInt   @id @default(autoincrement())
  campaignId BigInt   @map("campaign_id")
  code       String   @unique @db.VarChar(50)
  // isUsed: si el cupón ya fue utilizado
  isUsed     Boolean  @default(false) @map("is_used")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  campaign    DiscountCampaign   @relation(fields: [campaignId], references: [id])
  redemptions CouponRedemption[]

  @@map("discount_coupons")
}

model CouponRedemption {
  id         BigInt   @id @default(autoincrement())
  campaignId BigInt   @map("campaign_id")
  couponId   BigInt   @map("coupon_id")
  // userId: el padre que canjeó el cupón
  userId     BigInt   @map("user_id")
  redeemedAt DateTime @default(now()) @map("redeemed_at") @db.Timestamptz()

  campaign DiscountCampaign @relation(fields: [campaignId], references: [id])
  coupon   DiscountCoupon   @relation(fields: [couponId], references: [id])
  user     User             @relation(fields: [userId], references: [id])

  @@map("coupon_redemptions")
}

// ============================================================
// NOTIFICACIONES (cross-cutting)
// ============================================================

model Notification {
  id          BigInt   @id @default(autoincrement())
  schoolId    BigInt?  @map("school_id")
  triggerType String   @map("trigger_type") @db.VarChar(50)
  triggerId   BigInt?  @map("trigger_id")
  title       String   @db.VarChar(500)
  body        String
  data        Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  school     School?                @relation(fields: [schoolId], references: [id])
  deliveries NotificationDelivery[]

  @@map("notifications")
}

model NotificationDelivery {
  id             BigInt    @id @default(autoincrement())
  notificationId BigInt    @map("notification_id")
  userId         BigInt    @map("user_id")
  channel        String    @default("push") @db.VarChar(20)
  status         String    @default("pending") @db.VarChar(20)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz()
  readAt         DateTime? @map("read_at") @db.Timestamptz()

  notification Notification @relation(fields: [notificationId], references: [id])

  @@unique([notificationId, userId, channel])
  @@map("notification_deliveries")
}

// ============================================================
// PUSH NOTIFICATIONS — Tokens de dispositivo (FCM)
// ============================================================

model PushToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  // token FCM del dispositivo — único por dispositivo
  token     String   @unique
  // 'android' | 'ios'
  platform  String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

// ============================================================
// ONBOARDING — Invitaciones al colegio
// ============================================================

model SchoolInvitation {
  id        BigInt    @id @default(autoincrement())
  schoolId  BigInt    @map("school_id")
  // email: obligatorio para invitaciones de Parent (se valida en el service,
  // no aquí, porque las invitaciones genéricas de otros roles pueden no
  // necesitarlo). Nullable a nivel de columna para no romper compatibilidad.
  email     String?   @db.VarChar(128)
  roleId    Int       @map("role_id")
  // token único enviado por email/link de invitación (64 hex, 256 bits) —
  // pensado para el deep link (kolexa://register?token=...), que hoy
  // ningún cliente dispara todavía. No único a nivel de constraint global
  // (a diferencia de `token`): un código de 6 dígitos tiene un espacio
  // demasiado chico para reservarlo para siempre incluso después de
  // usado/vencido — la unicidad real se valida en el service, solo entre
  // invitaciones ACTIVAS (mismo criterio que ya usa la invitación
  // duplicada por email/parentId).
  token     String    @unique @db.VarChar(64)
  shortCode String?   @map("short_code") @db.VarChar(6)
  invitedBy BigInt?   @map("invited_by")
  // parentId: liga la invitación a un Parent institucional concreto.
  // Nullable porque las invitaciones genéricas (ej. docentes) no aplican.
  parentId  BigInt?   @map("parent_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  school  School  @relation(fields: [schoolId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])
  inviter User?   @relation("InvitationSender", fields: [invitedBy], references: [id])
  parent  Parent? @relation(fields: [parentId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([shortCode])
  @@map("school_invitations")
}

// ============================================================
// GOOGLE CLASSROOM INTEGRATION
// ============================================================

model GoogleToken {
  id           BigInt   @id @default(autoincrement())
  studentId    BigInt   @unique @map("student_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz()
  scope        String
  googleEmail  String?  @map("google_email")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  student Student @relation(fields: [studentId], references: [id])

  @@map("google_tokens")
}

model TeacherGoogleToken {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @unique @map("user_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz()
  scope        String
  googleEmail  String?  @map("google_email")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@map("teacher_google_tokens")
}

model GcTeacherCourse {
  id           BigInt   @id @default(autoincrement())
  teacherId    BigInt   @map("teacher_id")
  googleId     String   @map("google_id")
  name         String
  section      String?
  studentCount Int      @default(0) @map("student_count")
  syncedAt     DateTime @default(now()) @map("synced_at") @db.Timestamptz()

  teacher        User                  @relation(fields: [teacherId], references: [id])
  submissions    GcTeacherSubmission[]
  scheduleBlocks ScheduleBlock[]
  students       GcCourseStudent[]

  @@unique([teacherId, googleId])
  @@map("gc_teacher_courses")
}

model GcCourseStudent {
  id        BigInt   @id @default(autoincrement())
  courseId  BigInt   @map("course_id")
  googleId  String   @map("google_id")
  fullName  String   @map("full_name")
  email     String?
  photoUrl  String?  @map("photo_url")
  syncedAt  DateTime @default(now()) @map("synced_at") @db.Timestamptz()
  // Vínculo al alumno interno — permite notificaciones al padre específico
  studentId BigInt?  @map("student_id")

  course            GcTeacherCourse      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student           Student?             @relation("GcCourseStudentLink", fields: [studentId], references: [id])
  attendanceRecords GcAttendanceRecord[]

  @@unique([courseId, googleId])
  @@map("gc_course_students")
}

model GcAttendanceSession {
  id        BigInt   @id @default(autoincrement())
  teacherId BigInt   @map("teacher_id")
  date      DateTime @db.Date
  photoUrls Json     @default("[]") @map("photo_urls") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  teacher User                 @relation("GcAttendanceTeacher", fields: [teacherId], references: [id])
  records GcAttendanceRecord[]

  @@unique([teacherId, date])
  @@map("gc_attendance_sessions")
}

model GcAttendanceRecord {
  id        BigInt  @id @default(autoincrement())
  sessionId BigInt  @map("session_id")
  studentId BigInt  @map("student_id")
  status    String  @db.VarChar(20)
  note      String?

  session GcAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student GcCourseStudent     @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@map("gc_attendance_records")
}

model GcTeacherSubmission {
  id                 BigInt    @id @default(autoincrement())
  courseId           BigInt    @map("course_id")
  courseworkGoogleId String    @map("coursework_google_id")
  courseworkTitle    String    @map("coursework_title")
  studentGoogleId    String    @map("student_google_id")
  studentName        String?   @map("student_name")
  state              String
  submittedAt        DateTime? @map("submitted_at") @db.Timestamptz()
  syncedAt           DateTime  @default(now()) @map("synced_at") @db.Timestamptz()

  course GcTeacherCourse @relation(fields: [courseId], references: [id])

  @@unique([courseId, courseworkGoogleId, studentGoogleId])
  @@map("gc_teacher_submissions")
}

model GcCourse {
  id          BigInt   @id @default(autoincrement())
  studentId   BigInt   @map("student_id")
  googleId    String   @map("google_id")
  name        String
  section     String?
  teacherName String?  @map("teacher_name")
  syncedAt    DateTime @default(now()) @map("synced_at") @db.Timestamptz()

  student     Student        @relation(fields: [studentId], references: [id])
  courseworks GcCoursework[]

  @@unique([studentId, googleId])
  @@map("gc_courses")
}

model GcCoursework {
  id            BigInt    @id @default(autoincrement())
  courseId      BigInt    @map("course_id")
  googleId      String    @map("google_id")
  title         String
  description   String?
  dueDate       DateTime? @map("due_date") @db.Timestamptz()
  maxPoints     Float?    @map("max_points")
  workType      String    @map("work_type")
  state         String    @default("PUBLISHED")
  alternateLink String?   @map("alternate_link")
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz()

  course      GcCourse              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions GcStudentSubmission[]

  @@unique([courseId, googleId])
  @@index([courseId, state, workType, dueDate])
  @@map("gc_coursework")
}

model GcStudentSubmission {
  id              BigInt   @id @default(autoincrement())
  courseworkId    BigInt   @map("coursework_id")
  googleId        String   @map("google_id")
  submissionState String   @map("submission_state")
  assignedGrade   Float?   @map("assigned_grade")
  syncedAt        DateTime @default(now()) @map("synced_at") @db.Timestamptz()

  coursework GcCoursework @relation(fields: [courseworkId], references: [id], onDelete: Cascade)

  @@unique([courseworkId, googleId])
  @@index([courseworkId, submissionState, assignedGrade])
  @@map("gc_student_submissions")
}

// ============================================================
// SECCIÓN: PADRES / APODERADOS (información institucional)
// ============================================================
// Parent representa la información INSTITUCIONAL del padre/apoderado,
// separada de la cuenta de autenticación (User). Un Parent puede existir
// ANTES de que el padre cree su cuenta desde la app móvil.
//   - userId (opcional): se rellena cuando el padre se registra/vincula su cuenta.
//   - La relación con alumnos es muchos-a-muchos vía ParentStudent.
//   - La Web Admin gestiona esta información SIN crear cuentas ni contraseñas.
//   - Un User (cuenta) puede tener varios Parent (uno por colegio).
//
// ── SEGURIDAD FUTURA — VINCULACIÓN DE CUENTA (NO implementada todavía) ──
// El endpoint de vinculación desde la app deberá hacer, EN UNA TRANSACCIÓN:
//   1. Registro/activación del padre (crear/activar su User y rol 'parent').
//   2. Autenticación/verificación de identidad (token/invitación/código de
//      activación). NUNCA bastará con conocer un DNI o email para reclamar un Parent.
//   3. Localizar el Parent inequívocamente mediante (schoolId, dni).
//   4. Verificar que el usuario realmente tiene derecho a reclamar ese Parent.
//   5. Asignar Parent.userId.
//   6. Cambiar linkStatus a 'linked'.
//   7. Crear los UserStudent correspondientes (para que el login actual cargue
//      los hijos vía UserStudent).
// ⚠️ NUNCA permitir vinculación únicamente porque el usuario conoce un DNI o email.
// ============================================================

model Parent {
  id         BigInt   @id @default(autoincrement())
  schoolId   BigInt   @map("school_id")
  // userId opcional: se vincula cuando el padre crea/activa su cuenta desde la app.
  // NO es único: un User (cuenta) puede ser padre en varios colegios, por lo que
  // puede tener varios perfiles Parent (uno por colegio).
  // Invariante de consistencia (garantizada por el backend, no por CHECK SQL):
  //   - userId = null  → linkStatus NUNCA puede ser 'linked' (debe ser 'pending' o 'unlinked')
  //   - userId != null → linkStatus DEBE ser 'linked'
  //   - linkStatus = 'unlinked' → userId = null
  userId     BigInt?  @map("user_id")
  firstName  String   @map("first_name") @db.VarChar(255)
  lastName   String?  @map("last_name") @db.VarChar(255)
  dni        String?  @db.VarChar(20)
  phone      String?  @db.VarChar(20)
  email      String?  @db.VarChar(128)
  // Estado de vinculación de la cuenta (pending / linked / unlinked).
  // Valores validados a nivel de servicio/DTO (no hay CHECK SQL).
  linkStatus String   @default("pending") @map("link_status") @db.VarChar(20)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  school      School             @relation(fields: [schoolId], references: [id])
  user        User?              @relation(fields: [userId], references: [id])
  students    ParentStudent[]
  invitations SchoolInvitation[]

  @@unique([schoolId, dni])
  @@index([schoolId, isActive])
  @@index([userId])
  @@map("parents")
}

// ParentStudent: relación muchos-a-muchos entre Parent y Student.
// Soporta: Padre A → Hijo 1, Padre A → Hijo 2, Padre B → Hijo 1.
model ParentStudent {
  id           BigInt   @id @default(autoincrement())
  parentId     BigInt   @map("parent_id")
  studentId    BigInt   @map("student_id")
  relationship String?  @db.VarChar(50)
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@index([studentId])
  @@map("parent_students")
}
